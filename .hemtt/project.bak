name = "German Armed Forces [RHS]"
author = "braun"
mainprefix = "z"
prefix = "gaf2"
[version]
major = 1
minor = 0
patch = 0
git_hash = 0
[files]
include = ["mod.cpp", "meta.cpp", "logo_ca.paa","**/*.p3d","**/*.paa","**/*.rvmat","**/*.cpp","**/*.cfg",]
[exclude]
glob = ["*.psd", "*.tga", "*.png", "*.bak","*.hpp"]

[[addons]]
name = "air"
path = "addons/air"
include = [
    "**/*.p3d",
    "**/*.paa",
    "**/*.rvmat",
    "**/*.cpp",
            ]
[[addons]]
name = "air_ec135_compat"
path = "addons/air_ec135_compat"
include = [
    "**/*.p3d",
    "**/*.paa",
    "**/*.rvmat",
    "**/*.cpp",
            ]
